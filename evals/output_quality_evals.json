        },
        {
          "id": "visual-readability",
          "type": "human_or_llm",
          "check": "在 1200×500 尺寸下文字清晰可读，无文字溢出或相互遮挡",
          "severity": "high"
        }
      ]
    },
    {
      "id": "quality-flow-article-01",
      "prompt": "帮我画一张流程图配图，描述用户通过飞书机器人触发 AI 工作流的全过程",
