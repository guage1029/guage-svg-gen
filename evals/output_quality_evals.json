        {
          "id": "visual-info-density",
          "type": "human_or_llm",
          "check": "各卡片信息独立完整，有标题 + 要点，不堆砌文字",
          "severity": "medium"
        }
      ]
    },
    {
      "id": "quality-clay-cover-01",
      "prompt": "做一张黏土软萌风格公众号封面，主题是「AI 伴侣时代」",
