{
  "meta": {
    "skill": "guage-svg-gen",
    "version": "14.0",
    "description": "输出质量评测，共 12 个 case。每个 case 含机械断言（script 自动验证）、平台断言（规则验证）和视觉断言（human/LLM judge）。",
    "assertion_types": {
      "script": "由 svg_validator.py 自动检查，结果为 PASS/FAIL",
      "rule": "通过文本解析或正则匹配验证，结果为 PASS/FAIL",
      "human_or_llm": "需要人工审阅或 LLM judge 打分，结果为 PASS/FAIL/PARTIAL"
    },
    "grading": {
      "high_fail": "不通过 → 该 case 判定为 FAIL",
      "medium_fail": "不通过 → 记录为 WARNING，case 仍可 PASS",
      "low_fail": "不通过 → 记录为 NOTE，不影响结果",
      "pass_threshold": "所有 high severity 断言通过"
    }
  },
  "cases": [
    {
      "id": "quality-tech-dark-cover-01",
      "prompt": "帮我做一张公众号封面，主题是「从 RAG 到 Agent」，科技暗黑风格",
      "expected_platform": "wechat_cover",
      "expected_style": "tech_dark",
      "assertions": [
        {
          "id": "mech-viewbox",
          "type": "script",
          "check": "viewBox 为 0 0 1800 766",
          "severity": "high"
        },
        {
          "id": "mech-no-external",
          "type": "script",
          "check": "无外部资源链接（E_SECURITY_EXTERNAL 不存在）",
          "severity": "high"
        },
        {
          "id": "mech-id-prefix",
          "type": "script",
          "check": "所有 id 带 svga- 前缀（E_ID_PREFIX_MISSING 不存在）",
          "severity": "high"
        },
        {
          "id": "mech-font-fallback",
          "type": "script",
          "check": "所有文本有 font-family 且含 sans-serif/monospace（E_FONT_FALLBACK_MISSING 不存在）",
          "severity": "high"
        },
        {
          "id": "mech-font-size",
          "type": "script",
          "check": "字号 ≥ 18px（E_FONT_SIZE_TOO_SMALL 不存在）",
          "severity": "high"
        },
        {
          "id": "mech-a11y",
          "type": "script",
          "check": "包含 <title> 和 <desc>",
          "severity": "medium"
        },
        {
          "id": "platform-safe-area",
          "type": "rule",
          "check": "主要文字和关键视觉在水平中间 60% 区域内（x 在 360~1440 之间）",
          "severity": "high"
        },
        {
          "id": "visual-style",
          "type": "human_or_llm",
          "check": "背景深色，蓝/紫强调色，有发光效果，科技感强",
          "severity": "high"
        },
        {
          "id": "visual-hierarchy",
          "type": "human_or_llm",
          "check": "主标题突出，层级清晰（主标题 > 副标题 > 说明文字）",
          "severity": "high"
        },
        {
          "id": "visual-thumbnail",
          "type": "human_or_llm",
          "check": "缩略图（300×128）中标题仍可辨认，无被遮挡的关键信息",
          "severity": "medium"
        }
      ]
    },
    {
      "id": "quality-minimal-cover-01",
      "prompt": "做一张极简风格公众号封面，主题是「单一职责原则」",
      "expected_platform": "wechat_cover",
      "expected_style": "minimal_clean",
      "assertions": [
        {
          "id": "mech-viewbox",
          "type": "script",
          "check": "viewBox 为 0 0 1800 766",
          "severity": "high"
        },
        {
          "id": "mech-no-external",
          "type": "script",
          "check": "无外部资源链接",
          "severity": "high"
        },
        {
          "id": "mech-font-fallback",
          "type": "script",
          "check": "font-family 含 sans-serif fallback",
          "severity": "high"
        },
        {
          "id": "visual-style",
          "type": "human_or_llm",
          "check": "浅色/白色背景，大量留白，强调色不超过 2 种",
          "severity": "high"
        },
        {
          "id": "visual-no-clutter",
          "type": "human_or_llm",
          "check": "信息密度低，无过度装饰，重点突出",
          "severity": "medium"
        }
      ]
    },
    {
      "id": "quality-glass-cover-01",
      "prompt": "做一张公众号封面，主题是企业级 AI Agent 平台，玻璃高级感",
