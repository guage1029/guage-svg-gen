          "check": "所有 id 带 svga- 前缀",
          "severity": "high"
        },
        {
          "id": "visual-style",
          "type": "human_or_llm",
          "check": "深色背景，有半透明面板效果（opacity 层叠模拟玻璃），光晕强调，无仿 backdrop-filter",
          "severity": "high"
        },
        {
          "id": "thumbnail-focus",
          "type": "human_or_llm",
          "check": "主标题和关键视觉居中于水平 50% 区域",
          "severity": "medium"
        }
      ]
    },
    {
      "id": "quality-neubrutalism-cover-01",
      "prompt": "做一张新粗野主义风格封面，主题是「开源 LLM 大战」",
      "expected_platform": "wechat_cover",
