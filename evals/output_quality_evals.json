    {
      "id": "quality-revision-01",
      "prompt": "上一张图颜色太暗了，换成浅色风格重新出一版",
      "expected_platform": "wechat_cover",
      "expected_style": "minimal_clean",
      "assertions": [
        {
          "id": "rule-new-file",
          "type": "rule",
          "check": "生成了新的 SVG 文件（有独立文件路径或覆盖原文件），未产生 _v2/_new 等副本文件名",
