          "check": "viewBox 为 0 0 1800 766",
          "severity": "high"
        },
        {
          "id": "mech-no-external",
          "type": "script",
          "check": "无外部资源链接",
          "severity": "high"
        },
        {
          "id": "mech-id-prefix",
