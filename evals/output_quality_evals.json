          "id": "mech-font-fallback",
          "type": "script",
          "check": "font-family 含 sans-serif fallback",
          "severity": "high"
        },
        {
          "id": "visual-style",
          "type": "human_or_llm",
          "check": "有粗黑描边（stroke-width ≥ 4），硬投影（非模糊阴影），高饱和强调色",
          "severity": "high"
        },
        {
          "id": "visual-no-softness",
          "type": "human_or_llm",
          "check": "无发光效果、无高斯模糊、无半透明玻璃，风格硬朗",
          "severity": "medium"
        }
      ]
    },
    {
      "id": "quality-bento-cover-01",
      "prompt": "出一张 bento 格栅封面，展示 2026 年 5 大 AI 技术趋势",
      "expected_platform": "wechat_cover",
