{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SVG Layout Plan Schema v6",
  "description": "放宽约束并增强数值化的 70/30 构图计划",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewBox": { 
          "type": "string", 
          "pattern": "^-?\\d+(\\.\\d+)? -?\\d+(\\.\\d+)? \\d+(\\.\\d+)? \\d+(\\.\\d+)?$",
          "description": "标准 viewBox：wechat_article 默认 16:9 (0 0 1200 675)，固定宽 1200、高 500–1200（推荐 25 整数倍）；wechat_cover 固定 0 0 1800 766" 
        },
        "aspect_ratio": { "type": "string", "enum": ["16:9", "4:3", "1:1", "2.4:1", "2.35:1", "custom"] },
        "safe_area": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          },
          "required": ["x", "y", "width", "height"]
        }
      },
      "required": ["viewBox", "safe_area"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "type": "string", "enum": ["bg_dark", "bg_light"] },
        "platform": { "type": "string" },
        "language": { "type": "string", "enum": ["zh", "en", "mixed"] },
        "background_style": {
          "type": "string",
          "enum": ["dot", "line", "solid"],
          "description": "可选背景纹理档位：dot=25px工程微圆点阵（默认主力，配同底标签遮罩）；line=40px极淡疏朗线网（时间轴/轻量矩阵，配同底标签遮罩）；solid=纯色无网格底板（时序/泳道/数据图表/对比卡/封面或高密度图）"
        }
      },
      "required": ["theme", "platform"]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot_id": { "type": "string", "enum": ["background", "title_area", "info_area", "brand_mark", "legend_area"] },
          "rect": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number" },
              "h": { "type": "number" }
            },
            "required": ["x", "y", "w", "h"]
          },
          "content_type": { "type": "string" }
        },
        "required": ["slot_id", "rect"]
      }
    },
    "creative_zone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_area": { "type": "string" },
        "visual_language": { "type": "string" },
        "focal_point": { "type": "string" }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      },
      "required": ["background", "primary", "text"]
    },
    "color_system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "type": "string", "enum": ["bg_dark", "bg_light"] },
        "diagram_type": { "type": "string", "enum": ["architecture", "flowchart", "sequence", "state", "er", "deployment", "swimlane", "timeline", "comparison", "data_visualization", "hierarchy"] },
        "role_map": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "required": ["theme", "diagram_type", "role_map"]
    },
    "layout_constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orthogonal_edges": { "type": "boolean" },
        "uniform_node_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "nodes": {
                "type": "array",
                "minItems": 2,
                "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
              },
              "y": { "type": "number" },
              "height": { "type": "number", "exclusiveMinimum": 0 },
              "tolerance": { "type": "number", "minimum": 0 }
            },
            "required": ["id", "nodes"]
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "rect": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "exclusiveMinimum": 0 },
              "h": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["x", "y", "w", "h"]
          },
          "parent_zone": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "nodes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "label": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "padding": { "type": "number", "minimum": 0 }
        },
        "required": ["id", "rect"]
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "rect": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "exclusiveMinimum": 0 },
              "h": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["x", "y", "w", "h"]
          },
          "padding": { "type": "number", "minimum": 0 },
          "reserved": { "type": "array" },
          "ports": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              },
              "required": ["x", "y"]
            }
          }
        },
        "required": ["id", "rect", "ports"]
      }
    },
    "text_boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "node": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "zone": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "role": { "type": "string", "enum": ["default", "legend", "zone_label"] },
          "rect": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "exclusiveMinimum": 0 },
              "h": { "type": "number", "exclusiveMinimum": 0 }
            },
            "required": ["x", "y", "w", "h"]
          },
          "reserved_overlap": { "type": "array" }
        },
        "required": ["id", "rect"]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "from": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
          "to": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
          "directed": { "type": "boolean" },
          "route": { "type": "string", "enum": ["straight", "orthogonal", "bezier"] },
          "waypoints": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" }
              },
              "required": ["x", "y"]
            }
          },
          "min_clearance": { "type": "number", "minimum": 0 }
        },
        "required": ["id", "from", "to", "directed", "route", "waypoints"]
      }
    }
  },
  "required": ["canvas", "metadata", "slots", "creative_zone", "palette", "color_system", "nodes", "text_boxes", "edges"]
}
